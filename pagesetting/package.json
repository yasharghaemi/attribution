{
  "name": "pagesetting",
  "version": "1.0.0",
  "private": true,
  "description": "Custom Page settings panel for the MindTouch editor",
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:config",
    "build:js": "node scripts/build.mjs",
    "build:css": "esbuild pagesetting.css --minify --outfile=dist/pagesetting.min.css",
    "watch": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "dev:sandbox": "node scripts/dev.mjs 0.0.0.0",
    "build:config": "node -e \"const fs=require('fs');JSON.parse(fs.readFileSync('pagesetting.json','utf8'));fs.copyFileSync('pagesetting.json','dist/pagesetting.json')\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
