# Copy to .env (git-ignored) and adjust. Read at build time by npm run build / npm run dev
# (scripts/env.mjs) and written into the bundle.

# Host of the authors search API (no trailing slash); the panel calls
# <AUTHORS_API_HOST>/api/v1/authors/search. Defaults to https://knitcanvas.fun.
AUTHORS_API_HOST=https://knitcanvas.fun
