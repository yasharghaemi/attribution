# Copy to .env (git-ignored) and adjust. Read at build time by npm run build / npm run dev
# (scripts/env.mjs) and written into the bundle.

# Host of the authors API (no trailing slash); the badge calls
# <AUTHORS_API_HOST>/api/v1/authors/key/<key> for its live refresh. Defaults to
# https://knitcanvas.fun. Use the same host as AUTHORS_API_HOST in AuthorBadge.dekiscript.
AUTHORS_API_HOST=https://knitcanvas.fun
